{
  "name": "whatagooddeal",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "scripts": {
    "dev": "turbo run dev",
    "catalog:sync": "pnpm --filter @whatagooddeal/web catalog:sync",
    "catalog:build": "pnpm --filter @whatagooddeal/web catalog:build",
    "test:catalog": "pnpm --filter @whatagooddeal/web test:catalog",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "^2.9.14"
  }
}
